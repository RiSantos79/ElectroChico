generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EnergyClass {
  A
  B
  C
  D
  E
  F
  G
}

enum ProductBadge {
  PROMO
  NOVO
  MAIS_VENDIDO
}

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  orders       Order[]
  addresses    Address[]
}

model Address {
  id           String   @id @default(cuid())
  customer     User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId   String
  label        String?
  street       String
  streetNumber String
  floor        String?
  postalCode   String
  city         String
  phone        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
}

model Category {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  subcategories  String[]
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Product {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  brand        String
  category     Category      @relation(fields: [categoryId], references: [id])
  categoryId   String
  price        Decimal       @db.Decimal(10, 2)
  oldPrice     Decimal?      @db.Decimal(10, 2)
  energyClass  EnergyClass
  rating       Float         @default(0)
  reviewCount  Int           @default(0)
  reviews      Review[]
  images       String[]      @default([])
  stockQuantity Int          @default(0)
  badge        ProductBadge?
  color        String
  description  String
  specs        Json
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([categoryId])
  @@index([brand])
}

model Review {
  id          String   @id @default(cuid())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  authorName  String
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  @@index([productId])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model Order {
  id              String      @id @default(cuid())
  status          OrderStatus @default(PENDING)
  customer        User?       @relation(fields: [customerId], references: [id])
  customerId      String?
  customerName    String
  customerEmail   String
  customerPhone   String
  street          String
  streetNumber    String
  floor           String?
  postalCode      String
  city            String
  subtotal        Decimal     @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  stripeSessionId String?     @unique
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerId])
}

model OrderItem {
  id          String  @id @default(cuid())
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  productId   String
  productName String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int

  @@index([orderId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String?
  entityId  String?
  actor     String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
