generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EnergyClass {
  A
  B
  C
  D
  E
  F
  G
}

enum ProductBadge {
  PROMO
  NOVO
  MAIS_VENDIDO
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STOCK_MANAGER
  CUSTOMER_SUPPORT
  MARKETING
  FINANCE
  OPERATOR
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String
  name                String?
  phone               String?
  jobTitle            String?
  role                Role       @default(CUSTOMER)
  status              UserStatus @default(ACTIVE)
  permissionOverrides Json?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  mustChangePassword  Boolean    @default(false)
  mfaEnabled          Boolean    @default(false)
  mfaSecretEncrypted  String?
  mfaRecoveryCodes    String[]   @default([])
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())
  orders              Order[]
  addresses           Address[]
  contactMessages     ContactMessage[]
  sessions            Session[]
  passwordResets      PasswordResetToken[]
}

// Pedido de recuperação de password. O token nunca é guardado em claro: se a
// base de dados vazar, os links já emitidos continuam inúteis. Cada pedido
// apaga o anterior e o registo é apagado no uso, por isso o link serve uma
// única vez.
model PasswordResetToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

model Address {
  id           String   @id @default(cuid())
  customer     User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId   String
  label        String?
  street       String
  streetNumber String
  floor        String?
  postalCode   String
  city         String
  phone        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
}

model Category {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  imageUrl       String?
  subcategories  String[]
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String    @unique
  logoUrl   String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  brand          Brand         @relation(fields: [brandId], references: [id])
  brandId        String
  category       Category      @relation(fields: [categoryId], references: [id])
  categoryId     String
  price          Decimal       @db.Decimal(10, 2)
  oldPrice       Decimal?      @db.Decimal(10, 2)
  energyClass    EnergyClass
  rating         Float         @default(0)
  reviewCount    Int           @default(0)
  reviews        Review[]
  images         String[]      @default([])
  stockQuantity  Int           @default(0)
  badge          ProductBadge?
  color          String
  description    String
  specs          Json
  faqs           Json?
  sku            String?
  ean            String?
  weightKg       Float?
  widthCm        Float?
  heightCm       Float?
  depthCm        Float?
  warrantyMonths Int?
  archived       Boolean       @default(false)
  metaTitle      String?
  metaDescription String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  stockMovements StockMovement[]

  @@index([categoryId])
  @@index([brandId])
}

enum StockMovementType {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
}

model StockMovement {
  id        String            @id @default(cuid())
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  type      StockMovementType
  delta     Int
  reason    String?
  orderId   String?
  createdAt DateTime          @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Review {
  id          String   @id @default(cuid())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  authorName  String
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  @@index([productId])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  FAILED
}

model Order {
  id              String      @id @default(cuid())
  status          OrderStatus @default(PENDING)
  customer        User?       @relation(fields: [customerId], references: [id])
  customerId      String?
  customerName    String
  customerEmail   String
  customerPhone   String
  street          String
  streetNumber    String
  floor           String?
  postalCode      String
  city            String
  newsletterOptIn Boolean     @default(false)
  subtotal        Decimal     @db.Decimal(10, 2)
  discountAmount  Decimal?    @db.Decimal(10, 2)
  couponCode      String?
  total           Decimal     @db.Decimal(10, 2)
  stripeSessionId String?     @unique
  paymentMethod   String?
  // Momento em que o pagamento foi confirmado. É por esta data que as
  // vendas contam no dashboard — `updatedAt` mudava a cada alteração de
  // estado e fazia a receita saltar para o dia da edição.
  paidAt          DateTime?
  trackingCarrier String?
  trackingCode    String?
  reminderSentAt  DateTime?
  items           OrderItem[]
  giftCards       GiftCard[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerId])
}

model OrderItem {
  id             String    @id @default(cuid())
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  productId      String
  productName    String
  unitPrice      Decimal   @db.Decimal(10, 2)
  quantity       Int
  recipientEmail String?
  giftMessage    String?
  giftCard       GiftCard?

  @@index([orderId])
}

enum GiftCardStatus {
  ACTIVE
  REDEEMED
}

model GiftCard {
  id             String         @id @default(cuid())
  code           String         @unique
  value          Decimal        @db.Decimal(10, 2)
  status         GiftCardStatus @default(ACTIVE)
  order          Order          @relation(fields: [orderId], references: [id])
  orderId        String
  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id])
  orderItemId    String         @unique
  buyerEmail     String
  recipientEmail String?
  message        String?
  redeemedAt     DateTime?
  redeemedBy     String?
  createdAt      DateTime       @default(now())

  @@index([orderId])
}

enum ContactType {
  SUGGESTION
  MESSAGE
  RMA
  QUOTE
}

model ContactMessage {
  id          String         @id @default(cuid())
  type        ContactType
  customer    User?          @relation(fields: [customerId], references: [id])
  customerId  String?
  name        String
  email       String
  phone       String?
  subject     String?
  body        String
  orderId     String?
  productName String?
  status      String         @default("OPEN")
  replies     ContactReply[]
  createdAt   DateTime       @default(now())

  @@index([customerId])
  @@index([type])
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Decimal    @db.Decimal(10, 2)
  minOrderValue Decimal?   @db.Decimal(10, 2)
  maxUses       Int?
  usesCount     Int        @default(0)
  validFrom     DateTime?
  validUntil    DateTime?
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  // Última vez que este contacto foi empurrado para a plataforma de email
  // marketing. Nulo = ainda não sincronizado (ou conta nova/vazia).
  syncedAt       DateTime?
}

enum NewsletterCampaignStatus {
  DRAFT
  SENT
}

model NewsletterCampaign {
  id        String                   @id @default(cuid())
  subject   String
  body      String
  status    NewsletterCampaignStatus @default(DRAFT)
  sentAt    DateTime?
  sentCount Int                      @default(0)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
}

// Registo único (id fixo) com a informação da empresa e os textos do
// rodapé — o admin edita isto em vez de estar fixo no código.
model SiteSettings {
  id               String   @id @default("singleton")
  companyName      String?
  taxId            String?
  address          String?
  phone            String?
  email            String?
  facebookUrl      String?
  instagramUrl     String?
  copyrightText    String?
  trustBadge1Title String?
  trustBadge1Desc  String?
  trustBadge2Title String?
  trustBadge2Desc  String?
  trustBadge3Title String?
  trustBadge3Desc  String?
  trustBadge4Title String?
  trustBadge4Desc  String?
  updatedAt        DateTime @updatedAt
}

enum BannerSize {
  LARGE
  SMALL
}

// Banners do hero da homepage — ao contrário do ContentPage, esta é mesmo
// uma lista livre: o admin pode adicionar/remover campanhas à vontade.
model Banner {
  id          String     @id @default(cuid())
  size        BannerSize @default(LARGE)
  eyebrow     String?
  title       String
  description String?
  linkUrl     String
  ctaLabel    String?
  imageUrl    String?
  order       Int        @default(0)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([active, order])
}

// Conteúdo das páginas institucionais (Entregas, Privacidade, Contacto,
// Orçamentos) editável no backoffice — o slug corresponde à página no site,
// é um conjunto fixo, não uma lista de páginas livres criadas pelo admin.
model ContentPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  updatedAt DateTime @updatedAt
}

// Registo mínimo de páginas vistas, sem IP nem identificador de utilizador
// — só serve para agregados (horas de pico, volume por dia) no dashboard.
model PageView {
  id        String   @id @default(cuid())
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ContactReply {
  id               String         @id @default(cuid())
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  contactMessageId String
  body             String
  fromAdmin        Boolean
  createdAt        DateTime       @default(now())

  @@index([contactMessageId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String?
  entityId  String?
  actor     String?
  ip        String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum AiProvider {
  OPENAI
  AZURE_OPENAI
  ANTHROPIC
  GEMINI
  OLLAMA
  OPENROUTER
  COPILOT
}

// Configuração da IA — singleton, tal como SiteSettings. A chave fica
// cifrada (AES-256-GCM) e nunca sai da API: o frontend só recebe uma
// versão mascarada e o estado da ligação.
model AiSettings {
  id              String     @id @default("singleton")
  enabled         Boolean    @default(false)
  provider        AiProvider @default(OPENAI)
  apiKeyEncrypted String?
  model           String?
  baseUrl         String?
  updatedAt       DateTime   @updatedAt
}

// Histórico de utilização, para o admin ver consumo por funcionalidade.
model AiUsageLog {
  id               String   @id @default(cuid())
  feature          String
  provider         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  estimatedCostUsd Decimal  @default(0) @db.Decimal(12, 6)
  success          Boolean  @default(true)
  errorMessage     String?
  actor            String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([feature])
}

enum RecommendationStrategyKind {
  RULES
  ML
}

// Regras de recomendação configuráveis pelo administrador. A estratégia é
// um campo (e não código fixo) para que um modelo de ML possa entrar mais
// tarde por trás da mesma interface, sem mexer no resto da aplicação.
model RecommendationSettings {
  id                String                     @id @default("singleton")
  strategy          RecommendationStrategyKind @default(RULES)
  limit             Int                        @default(4)
  preferSameBrand   Boolean                    @default(true)
  priceTolerancePct Int                        @default(40)
  useCoPurchase     Boolean                    @default(true)
  mlEndpoint        String?
  mlApiKeyEncrypted String?
  updatedAt         DateTime                   @updatedAt
}

// Integração com a plataforma de email marketing (Sender.net). Registo único.
// A lista de subscritores e o consentimento continuam a ser nossos — isto
// guarda só as credenciais e o estado da sincronização.
model MarketingSettings {
  id              String    @id @default("singleton")
  enabled         Boolean   @default(false)
  apiKeyEncrypted String?
  // Grupo de destino no Sender. Muda quando se aponta para outra conta (ex.
  // na entrega ao cliente), por isso é configurável e não fixo no código.
  groupId         String?
  lastSyncAt      DateTime?
  lastSyncResult  String?
  updatedAt       DateTime  @updatedAt
}
